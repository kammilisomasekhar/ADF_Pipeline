					],
					"transformations": [
						{
							"name": "lookup2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          user as string,",
						"          department as string,",
						"          designation as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source(output(",
						"          user as string,",
						"          department as string,",
						"          designation as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source2",
						"source2, source1 lookup(source2@user == source1@user,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup2",
						"lookup2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          Sum as string",
						"     ),",
						"     partitionFileNames:['lookup.csv'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_lookup_dept_sou1')]",
				"[concat(variables('factoryId'), '/datasets/DS_Lookup_Dept1_Sou2')]",
				"[concat(variables('factoryId'), '/datasets/DS_lookup_Tr')]"
			]
