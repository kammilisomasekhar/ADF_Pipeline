{
	"name": "SurrogteKey_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SurrogateKey_DF_Sou",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Surrogate_Dest",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {month } as string,",
				"          sales as string,",
				"          profit as string,",
				"          location as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 keyGenerate(output(Row_Number as long),",
				"     startAt: 1L,",
				"     stepValue: 1L,",
				"     partitionBy('roundRobin', 2)) ~> surrogateKey1",
				"surrogateKey1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['SuggertkeyDest.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Row_Number,",
				"          sales,",
				"          profit,",
				"          location,",
				"          Month = {month }",
				"     ),",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}